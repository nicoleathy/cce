output_type: multiple_choice
doc_to_text: "{{query}}"
doc_to_target: "{{gold}}"
doc_to_choice: "{{choices}}"
process_results: !function utils.process_results
metric_list:
  - metric: acc
    aggregation: !function utils.nanmean
    higher_is_better: true
  - metric: acc_gold_removed
    aggregation: !function utils.nanmean
    higher_is_better: true
  - metric: acc_distractor_removed
    aggregation: !function utils.nanmean
    higher_is_better: true
  - metric: nota_false_positive
    aggregation: !function utils.nanmean
    higher_is_better: false
metadata:
  version: 2.0
