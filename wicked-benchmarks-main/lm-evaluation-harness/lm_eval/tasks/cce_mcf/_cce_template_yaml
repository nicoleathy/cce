output_type: multiple_choice
doc_to_text: !function utils.doc_to_text
doc_to_choice: !function utils.doc_to_choice
doc_to_target: !function utils.doc_to_target
target_delimiter: " "
process_results: !function utils.process_results_cce
metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true
  - metric: acc_gold_removed
    aggregation: !function utils.nanmean
    higher_is_better: true
  - metric: acc_distractor_removed
    aggregation: !function utils.nanmean
    higher_is_better: true
  - metric: nota_rate_distractor
    aggregation: !function utils.nanmean
    higher_is_better: false
  - metric: other_distractor_rate
    aggregation: !function utils.nanmean
    higher_is_better: false
  - metric: gold_removed_share
    aggregation: mean
    higher_is_better: true
metadata:
  version: 4.0
